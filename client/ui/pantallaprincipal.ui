      <property name="styleSheet">
       <string notr="true">/* El cartel de madera */
QFrame#marco_madera, QFrame#marco_madera_retomar {
    background-color: #f7b46d;
    border: 6px solid #8e4c19;
    border-radius: 12px;
    padding: 20px;
}

QLabel {
    color: #d11f00;
    font-size: 18px;
    font-weight: bold;
    font-family: &quot;Courier New&quot;;
}


QLineEdit {
    background-color: #ffc47a;
    border: 3px solid #8e4c19;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 16px;
    font-weight: bold;
    color: #5c2900;
	min-height: 35px;
	min-width: 250px;
	font-size: 20px;
}


QLineEdit:focus {
    background-color: #ffffff;
    border: 3px solid #d11f00;
}

QComboBox {
    background-color: #ffc47a;
    border: 3px solid #8e4c19;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 16px;
    font-weight: bold;
    color: #5c2900;
    min-height: 35px;
    min-width: 250px;
    font-family: &quot;Courier New&quot;;
}

QComboBox:focus {
    background-color: #ffffff;
    border: 3px solid #d11f00;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

QComboBox QAbstractItemView {
    background-color: #ffc47a;
    border: 3px solid #8e4c19;
    color: #5c2900;
    selection-background-color: #8e4c19;
    selection-color: #ffffff;
    font-size: 16px;
    font-weight: bold;
    font-family: &quot;Courier New&quot;;
}

QTableWidget {
    background-color: #ffc47a;
    border: 3px solid #8e4c19;
    border-radius: 4px;
    gridline-color: #8e4c19;
    color: #5c2900;
    font-size: 16px;
    font-weight: bold;
    font-family: &quot;Courier New&quot;;
    selection-background-color: #8e4c19;
    selection-color: #ffffff;
}

QTableWidget::item:selected {
    background-color: #8e4c19;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #f7b46d;
    color: #8e4c19;
    font-size: 16px;
    font-weight: bold;
    font-family: &quot;Courier New&quot;;
    border: 2px solid #8e4c19;
    padding: 4px;
}

QLabel#label_previsualizacion_personaje {
    background: transparent;
    border: none;
}

QPushButton[class="btn_flecha"],
QPushButton.btn_flecha {
    background-color: transparent;
    border: none;
    min-width: 28px;
    max-width: 28px;
    min-height: 26px;
    max-height: 26px;
    padding: 0px;
}

QPushButton[class="btn_flecha"]:hover,
QPushButton.btn_flecha:hover {
    background-color: transparent;
}

QPushButton[class="btn_flecha"]:pressed,
QPushButton.btn_flecha:pressed {
    padding-top: 2px;
}

QPushButton[class="btn_genero"],
QPushButton#btn_genero_masculino,
QPushButton#btn_genero_femenino {
    background-color: transparent;
    border: none;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px;
}

QPushButton[class="btn_genero"]:hover,
QPushButton#btn_genero_masculino:hover,
QPushButton#btn_genero_femenino:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

QPushButton[class="btn_genero"]:checked,
QPushButton#btn_genero_masculino:checked,
QPushButton#btn_genero_femenino:checked {
    background-color: rgba(255, 220, 180, 0.4);
    border: 2px solid #b33617;
    border-radius: 4px;
}

QPushButton#btn_randomizar {
    background-color: transparent;
    border: none;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px;
}

QPushButton#btn_randomizar:hover {
    background-color: transparent;
}

QPushButton#btn_randomizar:pressed {
    padding-top: 2px;
}

QLabel[class="label_valor_selector"],
QLabel.label_valor_selector {
    color: #5c2900;
    font-size: 15px;
    font-weight: bold;
    min-width: 130px;
    max-width: 130px;
    qproperty-alignment: AlignCenter;
}

QPushButton#btn_confirmar_personaje {
    background-color: transparent;
    border: none;
    min-width: 64px;
    max-width: 64px;
    min-height: 64px;
    max-height: 64px;
    padding: 0px;
}

QPushButton#btn_confirmar_personaje:hover {
    background-color: transparent;
}

QPushButton#btn_confirmar_personaje:pressed {
    padding-top: 3px;
}
}</string>
