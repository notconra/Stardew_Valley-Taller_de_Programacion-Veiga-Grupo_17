   <string notr="true">/* Fondo color cielo*/
QWidget#PantallaPrincipal {
    background-color: #3bb2ed;
}

/* Botones tipo madera*/
QPushButton {
    background-color: #f7b46d;
    border: 4px solid #8e4c19;
    border-radius: 8px;
    color: #8e4c19;
    font-size: 20px;
    font-weight: bold;
    padding: 10px 20px;
	outline: none;
    font-family: &quot;Courier New&quot;; /* Cambiar a una pixel-art */
}


QPushButton:hover {
    background-color: #ffd89e;
    border: 4px solid #a85a1e;
}


QPushButton:pressed {
    background-color: #d8964d;
    padding-top: 12px;
}</string>
