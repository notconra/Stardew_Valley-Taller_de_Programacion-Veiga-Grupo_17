  <property name="styleSheet">
   <string notr="true">/* Fondo transparente para ver el cielo animado */
QWidget#centralwidget, QStackedWidget#stackedWidget, QWidget#page {
    background: transparent;
}

/* Botones especiales del menú principal con sprites pixel-art */
QPushButton#btn_nueva_partida,
QPushButton#btn_retomar_partida,
QPushButton#btn_unirse_codigo,
QPushButton#btn_salir {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-width: 118px;
    min-height: 93px;
    max-width: 118px;
    max-height: 93px;
}

QPushButton#btn_nueva_partida:hover,
QPushButton#btn_retomar_partida:hover,
QPushButton#btn_unirse_codigo:hover,
QPushButton#btn_salir:hover {
    background-color: transparent;
    border: none;
}

QPushButton#btn_nueva_partida:pressed,
QPushButton#btn_retomar_partida:pressed,
QPushButton#btn_unirse_codigo:pressed,
QPushButton#btn_salir:pressed {
    background-color: transparent;
    border: none;
    padding-top: 3px;
}

/* Botones tipo madera*/
QPushButton {
    background-color: #f7b46d;
    border: 4px solid #8e4c19;
    border-radius: 8px;
    color: #8e4c19;
    font-size: 22px;
    font-weight: normal;
    padding: 10px 20px;
	outline: none;
    font-family: &quot;Stardew Valley&quot;, &quot;Ubuntu&quot;, sans-serif;
}


QPushButton:hover {
    background-color: #ffd89e;
    border: 4px solid #a85a1e;
}


QPushButton:pressed {
    background-color: #d8964d;
    padding-top: 12px;
}

/* El cartel de madera */
QFrame#marco_madera {
    border-image: url("Assets/LooseSprites/menu_box.png") 12 12 12 12 repeat;
    border-width: 12px;
    padding: 16px;
}

/* Marco de madera de retomar partida: 0 padding para que las tarjetas toquen el borde */
QFrame#marco_madera_retomar {
    border-image: url("Assets/LooseSprites/menu_box_retomar.png") 12 12 12 12 repeat;
    border-width: 12px;
    padding: 0px;
}

QLabel {
    color: #d11f00;
    font-size: 25px;
    font-weight: normal;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
}

QLineEdit {
    border-image: url("Assets/LooseSprites/textBox.png") 8 12 8 12 repeat;
    border-width: 8px 12px 8px 12px;
    background-color: transparent;
    padding: 2px 8px;
    font-size: 20px;
    font-weight: normal;
    color: #4a2105;
    min-height: 28px;
    min-width: 150px;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
}

QLineEdit:focus {
    border-image: url("Assets/LooseSprites/textBox.png") 8 12 8 12 repeat;
    border-width: 8px 12px 8px 12px;
}

QComboBox {
    border-image: url("Assets/LooseSprites/textBox.png") 8 12 8 12 repeat;
    border-width: 8px 12px 8px 12px;
    background-color: transparent;
    padding: 2px 8px;
    font-size: 18px;
    font-weight: normal;
    color: #4a2105;
    min-height: 28px;
    min-width: 150px;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
}

QComboBox:focus {
    border-image: url("Assets/LooseSprites/textBox.png") 8 12 8 12 repeat;
    border-width: 8px 12px 8px 12px;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

QComboBox QAbstractItemView {
    background-color: #ffc47a;
    border: 3px solid #8e4c19;
    color: #5c2900;
    selection-background-color: #8e4c19;
    selection-color: #ffffff;
    font-size: 18px;
    font-weight: normal;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
}

QTableWidget {
    background-color: #ffc47a;
    border: 3px solid #8e4c19;
    border-radius: 4px;
    gridline-color: #8e4c19;
    color: #5c2900;
    font-size: 18px;
    font-weight: normal;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    selection-background-color: #8e4c19;
    selection-color: #ffffff;
}

QTableWidget::item:selected {
    background-color: #8e4c19;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #f7b46d;
    color: #8e4c19;
    font-size: 18px;
    font-weight: normal;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    border: 2px solid #8e4c19;
    padding: 4px;
}

QLabel#label_previsualizacion_personaje {
    background: transparent;
    border: none;
}

QPushButton[class="btn_flecha"],
QPushButton.btn_flecha {
    background-color: transparent;
    border: none;
    min-width: 36px;
    max-width: 36px;
    min-height: 33px;
    max-height: 33px;
    padding: 0px;
}

QPushButton[class="btn_flecha"]:hover,
QPushButton.btn_flecha:hover {
    background-color: transparent;
}

QPushButton[class="btn_flecha"]:pressed,
QPushButton.btn_flecha:pressed {
    padding-top: 2px;
}

QPushButton[class="btn_genero"],
QPushButton#btn_genero_masculino,
QPushButton#btn_genero_femenino {
    background-color: transparent;
    border: 3px solid transparent;
    border-radius: 4px;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    padding: 0px;
}

QPushButton[class="btn_genero"]:hover,
QPushButton#btn_genero_masculino:hover,
QPushButton#btn_genero_femenino:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border: 3px solid transparent;
    border-radius: 4px;
}

QPushButton[class="btn_genero"]:checked,
QPushButton#btn_genero_masculino:checked,
QPushButton#btn_genero_femenino:checked {
    background-color: transparent;
    border: 3px solid #b33617;
    border-radius: 4px;
}

/* Botones de selección de tipo de granja */
QFrame#contenedor_lateral_granjas {
    border-image: url("Assets/LooseSprites/menu_box.png") 12 12 12 12 repeat;
    border-width: 12px;
    padding: 8px;
    background-color: transparent;
}

QPushButton[class="btn_granja"] {
    background-color: transparent;
    border: 3px solid transparent;
    border-radius: 4px;
    min-width: 48px;
    max-width: 48px;
    min-height: 44px;
    max-height: 44px;
    padding: 0px;
}

QPushButton[class="btn_granja"]:hover {
    border: 3px solid #e09642;
    border-radius: 4px;
}

QPushButton[class="btn_granja"]:checked {
    border: 3px solid #d22a2a;
    border-radius: 4px;
}

QToolTip {
    background-color: #ffeed3;
    color: #4c2207;
    border: 2px solid #8e4c19;
    border-radius: 4px;
    padding: 6px;
    font-size: 14px;
}


QPushButton#btn_randomizar {
    background-color: transparent;
    border: none;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0px;
}

QPushButton#btn_randomizar:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

QPushButton#btn_randomizar:pressed {
    padding-top: 2px;
}

QLabel[class="label_titulo_selector"] {
    color: #000000;
    font-size: 20px;
    font-weight: normal;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    qproperty-alignment: AlignCenter;
}

QLabel[class="label_valor_selector"],
QLabel.label_valor_selector {
    color: #000000;
    font-size: 20px;
    font-weight: normal;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    qproperty-alignment: AlignCenter;
    margin: 0px;
    padding: 0px;
}

QPushButton#btn_confirmar_personaje {
    background-color: transparent;
    border: none;
    min-width: 64px;
    max-width: 64px;
    min-height: 64px;
    max-height: 64px;
    padding: 0px;
}

QPushButton#btn_confirmar_personaje:hover {
    background-color: transparent;
}

QPushButton#btn_confirmar_personaje:pressed {
    padding-top: 3px;
}

QLabel[class="label_seccion_color"] {
    color: #000000;
    font-size: 20px;
    font-weight: normal;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    min-width: 175px;
}

QLabel[class="label_slider_valor"] {
    color: #000000;
    font-size: 18px;
    font-weight: normal;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    min-width: 32px;
    max-width: 32px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
}

QSlider {
    max-width: 170px;
    min-width: 130px;
    min-height: 14px;
    max-height: 14px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #ffc47a;
    border: 1px solid #5c2b0e;
    border-radius: 2px;
}

QSlider[class="slider_h"]::groove:horizontal {
    height: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ff0000, stop:0.17 #ffff00, stop:0.33 #00ff00, stop:0.5 #00ffff, stop:0.67 #0000ff, stop:0.83 #ff00ff, stop:1 #ff0000);
    border: 1px solid #5c2b0e;
    border-radius: 2px;
}

QSlider[class="slider_s"]::groove:horizontal {
    height: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #909090, stop:1 #ff3333);
    border: 1px solid #5c2b0e;
    border-radius: 2px;
}

QSlider[class="slider_v"]::groove:horizontal {
    height: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a1a1a, stop:1 #ffffff);
    border: 1px solid #5c2b0e;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #ba6328;
    border: 1px solid #4a2105;
    width: 8px;
    margin: -5px 0;
    border-radius: 3px;
}

QSlider::handle:horizontal:hover {
    background-color: #d87e38;
}

QSlider::handle:horizontal:pressed {
    background-color: #9c4c1a;
}

/* Ranura de partida guardada idéntica al original de Stardew Valley */
QFrame[class="tarjeta_partida"] {
    border-image: url("Assets/LooseSprites/tarjeta_slot.png") 15 15 15 15 repeat;
    border-width: 15px;
    background-color: transparent;
}

QFrame[class="tarjeta_partida"]:hover {
    border-image: url("Assets/LooseSprites/tarjeta_slot_hover.png") 15 15 15 15 repeat;
    border-width: 15px;
    background-color: transparent;
}

QFrame[class="tarjeta_partida"][seleccionada="true"] {
    border-image: url("Assets/LooseSprites/tarjeta_slot_seleccionada.png") 15 15 15 15 repeat;
    border-width: 15px;
    background-color: transparent;
}

/* Textos de la tarjeta */
QLabel[class="label_partida_slot"] {
    color: #431f08;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    font-size: 28px;
    font-weight: bold;
    background: transparent;
    border: none;
}

QLabel[class="label_partida_nombre"] {
    color: #431f08;
    font-family: "Stardew Dialogue", "Stardew Valley", "Ubuntu", sans-serif;
    font-size: 28px;
    font-weight: normal;
    background: transparent;
    border: none;
}

QLabel[class="label_partida_granja"] {
    color: #431f08;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    font-size: 24px;
    font-weight: normal;
    background: transparent;
    border: none;
}

QLabel[class="label_partida_fecha"] {
    color: #6b401f;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    font-size: 21px;
    background: transparent;
    border: none;
}

QLabel[class="label_partida_tiempo"] {
    color: #431f08;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    font-size: 20px;
    font-weight: normal;
    background: transparent;
    border: none;
}

QLabel[class="label_partida_estado"] {
    color: #8e5932;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    font-size: 18px;
    background: transparent;
    border: none;
}

/* Boton de eliminar chico sin bordes arriba a la derecha */
QPushButton[class="btn_eliminar_partida"] {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

QPushButton[class="btn_eliminar_partida"]:pressed {
    padding-top: 1px;
    padding-left: 1px;
}

/* ScrollArea de partidas guardadas */
QScrollArea#scroll_area_partidas {
    background-color: transparent;
    border: none;
}

QWidget#contenido_scroll_partidas {
    background-color: transparent;
}

/* Barra de scroll temática Stardew exterior */
QScrollBar#scrollbar_partidas:vertical {
    border: 2px solid #8e4c19;
    background-color: #e6b375;
    width: 24px;
    margin: 28px 0px 28px 0px;
    border-radius: 4px;
}

QScrollBar#scrollbar_partidas::handle:vertical {
    background-color: #ba6328;
    border: 2px solid #5c2900;
    border-radius: 4px;
    min-height: 36px;
}

QScrollBar#scrollbar_partidas::handle:vertical:hover {
    background-color: #d87e38;
}

QScrollBar#scrollbar_partidas::handle:vertical:pressed {
    background-color: #9c4b18;
}

/* Boton de flecha arriba */
QScrollBar#scrollbar_partidas::sub-line:vertical {
    border: none;
    background: transparent;
    height: 26px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar#scrollbar_partidas::sub-line:vertical:pressed {
    top: 1px;
}

/* Boton de flecha abajo */
QScrollBar#scrollbar_partidas::add-line:vertical {
    border: none;
    background: transparent;
    height: 26px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar#scrollbar_partidas::add-line:vertical:pressed {
    bottom: -1px;
}

/* Iconos de flechas pixel-art Stardew */
QScrollBar#scrollbar_partidas::up-arrow:vertical {
    image: url("Assets/LooseSprites/scrollbar_flecha_arriba.png");
    width: 20px;
    height: 22px;
}

QScrollBar#scrollbar_partidas::down-arrow:vertical {
    image: url("Assets/LooseSprites/scrollbar_flecha_abajo.png");
    width: 20px;
    height: 22px;
}

QScrollBar#scrollbar_partidas::add-page:vertical,
QScrollBar#scrollbar_partidas::sub-page:vertical {
    background: none;
}

/* Mensaje cuando no hay partidas guardadas */
QLabel#label_sin_partidas {
    color: #6b401f;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    font-size: 18px;
    font-style: italic;
    background: transparent;
    padding: 30px;
}

/* Diálogos modales con marco Stardew de madera y pergamino */
QDialog#dialogo_modal_stardew {
    background: transparent;
}

QFrame#marco_dialogo_stardew {
    border-image: url("Assets/LooseSprites/menu_box_retomar.png") 12 12 12 12 repeat;
    border-width: 16px;
    background-color: #ffd284;
}

QLabel#label_texto_dialogo {
    color: #431f08;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
    font-size: 22px;
    background: transparent;
    border: none;
    min-width: 380px;
}

/* El input para el código de invitación (centrado y estilizado) */
QLineEdit#input_codigo_invitacion {
    border-image: url("Assets/LooseSprites/textBox.png") 8 12 8 12 repeat;
    border-width: 8px 12px 8px 12px;
    background-color: transparent;
    padding: 4px 12px;
    font-size: 22px;
    font-weight: normal;
    color: #4a2105;
    min-height: 32px;
    min-width: 220px;
    max-width: 260px;
    font-family: "Stardew Valley", "Ubuntu", sans-serif;
}

QLineEdit#input_codigo_invitacion:focus {
    border-image: url("Assets/LooseSprites/textBox.png") 8 12 8 12 repeat;
    border-width: 8px 12px 8px 12px;
}

/* Botones de accion en dialogos modales (OK / Cancelar) */
QPushButton#btn_dialogo_ok,
QPushButton#btn_dialogo_cancelar,
QPushButton.btn_dialogo_accion {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QPushButton#btn_dialogo_ok:hover,
QPushButton#btn_dialogo_cancelar:hover,
QPushButton.btn_dialogo_accion:hover {
    background-color: transparent;
    border: none;
}

QPushButton#btn_dialogo_ok:pressed,
QPushButton#btn_dialogo_cancelar:pressed,
QPushButton.btn_dialogo_accion:pressed {
    background-color: transparent;
    border: none;
    padding-top: 3px;
}
</string>
