<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PantallaPrincipal</class>
 <widget class="QMainWindow" name="PantallaPrincipal">
  <property name="geometry">
   <rect>
    <x>0</x>
